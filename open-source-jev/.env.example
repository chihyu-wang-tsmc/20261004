# 複製成 .env 再填：cp .env.example .env
# 每個 LLM 都走 OpenAI 相容的 API（/v1/chat/completions），變數名稱見 models.py。

# ---- datasets 目錄：預設是 open-source-jev 旁邊的 ../datasets，放別的地方才要設 ----
# JEV_DATASETS_DIR=/path/to/datasets

# ---- H2O-Lightning-4B：本機 shim（服務怎麼起來見 README）----
H2O_BASE_URL=http://localhost:8741

# ---- Gemini 3.5 Flash：公司 AI gateway（作答的 powerful：run_bench.py、routing、guard 的第 2 步）----
GEMINI_35_FLASH_BASE_URL=https://your-gateway.example.com/v1
GEMINI_35_FLASH_TOKEN=
# GEMINI_35_FLASH_MODEL=gemini-3.5-flash

# ---- Gemini 3.7 Flash：公司 AI gateway（coding_report.py 的 Gemini classifier）----
GEMINI_37_FLASH_BASE_URL=https://your-gateway.example.com/v1
GEMINI_37_FLASH_TOKEN=
# gateway 上的模型名稱不是 gemini-3.7-flash 的話才要設
# GEMINI_37_FLASH_MODEL=gemini-3.7-flash

# ---- Gemma 4 31B（routing 的預設 fast、guard 的 fast）----
GEMMA_4_31B_BASE_URL=https://your-gateway.example.com/v1
GEMMA_4_31B_TOKEN=
# GEMMA_4_31B_MODEL=gemma-4-31b

# ---- Qwen3.5-0.8B（例如本機 vLLM：vllm serve Qwen/Qwen3.5-0.8B --served-model-name qwen3.5-0.8b --port 8001）----
QWEN35_08B_BASE_URL=http://localhost:8001/v1
# QWEN35_08B_TOKEN=
# QWEN35_08B_MODEL=qwen3.5-0.8b
